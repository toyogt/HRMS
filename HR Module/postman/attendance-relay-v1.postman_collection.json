    {
      "name": "Machine Photo",
      "item": [
        {
          "name": "POST /api/machine/xml/execute - GetDeviceDetails",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machine_ip\": \"{{machine_ip}}\",\n  \"machine_port\": {{machine_port}},\n  \"machine_number\": {{machine_number}},\n  \"request_name\": \"GetDeviceDetails\",\n  \"parse_fields\": [\n    { \"tag\": \"ErrorCode\", \"value_type\": \"int\" },\n    { \"tag\": \"ErrStr\", \"value_type\": \"string\" }\n  ],\n  \"return_response_xml\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/machine/xml/execute",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "machine",
                "xml",
                "execute"
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST /api/machine/xml/execute - SetUserPhotoData",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machine_ip\": \"{{machine_ip}}\",\n  \"machine_port\": {{machine_port}},\n  \"machine_number\": {{machine_number}},\n  \"request_name\": \"SetUserPhotoData\",\n  \"fields\": [\n    { \"tag\": \"UserID\", \"value\": {{user_id}}, \"value_type\": \"long\" }\n  ],\n  \"binary_fields\": [\n    { \"tag\": \"PhotoData\", \"data_base64\": \"{{photo_data_base64_8192}}\" }\n  ],\n  \"parse_fields\": [\n    { \"tag\": \"ErrorCode\", \"value_type\": \"int\" },\n    { \"tag\": \"ErrStr\", \"value_type\": \"string\" }\n  ],\n  \"return_response_xml\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/machine/xml/execute",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "machine",
                "xml",
                "execute"
              ]
            },
            "description": "photo_data_base64_8192 must be base64 for exactly 8192 bytes (padded if needed)."
          },
          "response": []
        },
        {
          "name": "POST /api/machine/xml/execute - GetUserPhotoData",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machine_ip\": \"{{machine_ip}}\",\n  \"machine_port\": {{machine_port}},\n  \"machine_number\": {{machine_number}},\n  \"request_name\": \"GetUserPhotoData\",\n  \"fields\": [\n    { \"tag\": \"UserID\", \"value\": {{user_id}}, \"value_type\": \"long\" }\n  ],\n  \"parse_fields\": [\n    { \"tag\": \"ErrorCode\", \"value_type\": \"int\" },\n    { \"tag\": \"ErrStr\", \"value_type\": \"string\" }\n  ],\n  \"parse_binary_fields\": [\n    { \"tag\": \"PhotoData\", \"length\": 8192 }\n  ],\n  \"return_response_xml\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/machine/xml/execute",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "machine",
                "xml",
                "execute"
              ]
            }
          },
          "response": []
        }
